# =====================================================================
# Guidio AI server configuration.
# Copy this file to ".env" and fill in your own values.
# NEVER commit ".env" and never paste real keys into this example file.
# Variables marked (optional) can be deleted; the default is shown.
# =====================================================================

# ---- Server ----------------------------------------------------------
NODE_ENV=development
# Render sets PORT automatically. Locally you can leave 5000.
PORT=5000
# debug | info | warn | error  (default: debug locally, info in production)
# LOG_LEVEL=info

# ---- CORS: browser origins allowed to call this API -------------------
# Comma-separated, no trailing slash. REQUIRED in production.
# Example for production: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the app. Defaults: 1 in production, 0 locally.
# TRUST_PROXY=1

# ---- Database (MongoDB Atlas) ------------------------------------------
# Atlas > Connect > Drivers. Include the database name before the "?".
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ---- Clerk (Development instance keys start with sk_test_ / pk_test_) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ---- AI providers --------------------------------------------------------
# Configure at least ONE. Providers are tried in AI_PROVIDER_ORDER; if one is
# rate limited or down, the next one is used automatically.
# Free-tier limits and model names change. Check each provider's current
# limits, terms and model list before relying on them.

# Google Gemini (AI Studio key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Use the exact model ID shown in Google AI Studio for your key.
GEMINI_MODEL=gemini-3.8-flash

# Groq (API key: https://console.groq.com/keys). Optional fallback.
GROQ_API_KEY=
# Groq retires models regularly. Check https://console.groq.com/docs/deprecations
# and https://console.groq.com/docs/models before changing this.
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (local open-source models). Leave unset on Render: it cannot run there.
# Locally: install Ollama, run "ollama pull llama3.2", then uncomment:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_NUM_CTX=8192

# Order providers are tried in (names you do not configure are skipped).
AI_PROVIDER_ORDER=gemini,groq,ollama

# Optional tuning (defaults shown):
# Time limit for ONE provider attempt (JSON requests and first stream chunk), ms.
# AI_TIMEOUT_MS=30000
# Local Ollama models on a CPU are slow, so they get their own limit, ms.
# AI_LOCAL_TIMEOUT_MS=120000
# Longest silence allowed between two streamed chunks, ms.
# AI_STREAM_IDLE_TIMEOUT_MS=30000
# Extra attempts on the SAME provider for temporary 5xx / network errors (0-2).
# AI_MAX_RETRIES=1

# ---- Inngest (background jobs) ------------------------------------------
# Local development: run "npx inngest-cli@latest dev" and set INNGEST_DEV=1.
INNGEST_DEV=1
# Production: copy both keys from the Inngest dashboard (leave INNGEST_DEV unset).
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=